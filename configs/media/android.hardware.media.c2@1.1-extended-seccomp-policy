# Appended to android.hardware.media.c2@1.1-seccomp_policy by SetUpMinijail();
# the base file is the blob's and is left alone. Adding a syscall the base
# never names is the only thing an append can do -- minijail keeps the first
# definition of a duplicate -- so every line here is absent from the base.
#
# Rockchip's own "for AIPQ" block allows every syscall that operates on a
# socket and none that creates one, so rkauth_activate() takes a SIGSYS and
# minijail aborts the codec service. BRINGUP-NOTES.md 4.6 and 7.27.
socket: 1
connect: 1
bind: 1
shutdown: 1
sendmsg: 1
socketpair: 1
epoll_create1: 1
epoll_ctl: 1
epoll_pwait: 1
fcntl: 1

# Bionic and libbinder are two platform releases newer than this policy.
statx: 1
prlimit64: 1
rseq: 1
clock_nanosleep: 1
clock_getres: 1
faccessat2: 1
dup3: 1
uname: 1
tkill: 1
set_robust_list: 1
get_robust_list: 1
sched_getaffinity: 1
unlinkat: 1
getcwd: 1
