<!--
     Rockchip-proprietary HALs that exist in no AOSP framework compatibility
     matrix. Without declaring them here as optional, checkvintf reports:

         The following instances are in the device manifest but not specified
         in framework compatibility matrix:
             rockchip.hardware.outputmanager@1.0::IRkOutputManager/default
             rockchip.hardware.rockit.hw@1.0::IRockitHwService/default

     Wired up through DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE.
-->
<compatibility-matrix version="2.0" type="framework">
    <!-- Display output/mode management, used by the Rockchip HWC. -->
    <hal format="hidl" optional="true">
        <name>rockchip.hardware.outputmanager</name>
        <version>1.0</version>
        <interface>
            <name>IRkOutputManager</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Rockit media service, backs the Rockchip Codec2 store. -->
    <hal format="hidl" optional="true">
        <name>rockchip.hardware.rockit.hw</name>
        <version>1.0</version>
        <interface>
            <name>IRockitHwService</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
