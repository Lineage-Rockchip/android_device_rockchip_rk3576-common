// Shims for symbols the stock RK3576 blobs were built against but which no
// longer exist in Android 14 as LineageOS ships it. They are attached to the
// individual blobs with patchelf --add-needed, from blob_fixups in
// extract-files.py, rather than being loaded globally.
//
// libui_shim is not defined here: hardware/lineage/compat already provides one
// carrying exactly the two GraphicBufferMapper entry points the Rockchip camera
// implementations want, and the blobs pull it in as a dependency.
//
// The -rk suffix is not decoration. hardware/lineage/compat has its own
// libcrypto_shim (libcrypto/cbs.c, an unrelated set of symbols), and two
// modules of one name are fatal once Make flattens the namespaces:
//
//   base_rules.mk:320: error: device/rockchip/rk3576-common/libshims:
//   MODULE.TARGET.SHARED_LIBRARIES.libcrypto_shim already defined by
//   hardware/lineage/compat.

cc_library_shared {
    name: "libcrypto_shim_rk",
    srcs: ["crypto_shim.cpp"],
    shared_libs: ["libcrypto"],
    vendor: true,
}
